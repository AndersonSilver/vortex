# ---------- Postgres ----------
POSTGRES_USER=vortex
POSTGRES_PASSWORD=vortex
POSTGRES_DB=vortex
POSTGRES_PORT=5433
DATABASE_URL=postgres://vortex:vortex@localhost:5433/vortex

# ---------- API ----------
API_PORT=3333
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
WEB_ORIGIN=http://localhost:5173

# ---------- Web ----------
VITE_API_URL=http://localhost:3333
VITE_MERCADOPAGO_PUBLIC_KEY=TEST-public-key

# ---------- Login com Google ----------
# Criar em console.cloud.google.com > APIs e serviços > Credenciais > OAuth client ID (Web application)
# Authorized redirect URI precisa ser exatamente: http://localhost:3333/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3333/auth/google/callback

# ---------- Mercado Pago (sandbox) ----------
MERCADOPAGO_ACCESS_TOKEN=TEST-access-token
# Gerada em Suas integrações > sua aplicação > Webhooks > Configurar notificações > Chave secreta.
# Usada para validar a assinatura (x-signature) das notificações recebidas em /webhooks/mercadopago.
MERCADOPAGO_WEBHOOK_SECRET=change-me-webhook

# ---------- Frete (Melhor Envio + fallback Correios) ----------
CORREIOS_CEP_ORIGEM=01001000
# Token gerado em melhorenvio.com.br (ou sandbox.melhorenvio.com.br) > Meus Aplicativos > Gerar Token
MELHOR_ENVIO_TOKEN=
# "sandbox" (padrão, para testes) ou "production"
MELHOR_ENVIO_ENV=sandbox
# Usadas apenas se a chamada ao Melhor Envio falhar ou o token não estiver configurado
CORREIOS_FALLBACK_PAC_PRICE=24.90
CORREIOS_FALLBACK_SEDEX_PRICE=39.90
CORREIOS_FALLBACK_PAC_DAYS=5
CORREIOS_FALLBACK_SEDEX_DAYS=2

# ---------- MinIO (S3-compatible storage) ----------
MINIO_ROOT_USER=vortex
MINIO_ROOT_PASSWORD=vortex12345
MINIO_ENDPOINT=http://localhost:9010
MINIO_PUBLIC_ENDPOINT=http://localhost:9010
MINIO_BUCKET=vortex-quotes
MINIO_ACCESS_KEY=vortex
MINIO_SECRET_KEY=vortex12345
